<!DOCTYPE html>
<html lang="uz" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Virtual Ofis — Smart Workspace</title>
<style>
  :root{
    --bg:#eef2f9; --panel:#ffffff; --panel-2:#f6f8fd; --text:#16233b; --muted:#6b7a94;
    --border:#e2e8f4; --accent1:#4f7cff; --accent2:#7c5cff; --ok:#22b573; --busy:#ff9f43;
    --off:#9aa7bd; --shadow:0 10px 30px rgba(30,50,90,.10);
    --room-bg:#f8faff; --room-border:#dbe4f5;
  }
  [data-theme="dark"]{
    --bg:#0e1626; --panel:#16203a; --panel-2:#1c2745; --text:#e8eefc; --muted:#93a1c0;
    --border:#263454; --shadow:0 10px 30px rgba(0,0,0,.45); --room-bg:#182340; --room-border:#2a3a60;
  }
  *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,-apple-system,sans-serif}
  body{background:var(--bg);color:var(--text);transition:background .3s,color .3s;min-height:100vh}

  /* ---------- Top bar ---------- */
  .topbar{
    display:flex;align-items:center;gap:18px;flex-wrap:wrap;
    padding:12px 22px;background:linear-gradient(120deg,var(--accent1),var(--accent2));
    color:#fff;box-shadow:var(--shadow);position:sticky;top:0;z-index:50;
  }
  .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:20px;letter-spacing:.3px}
  .logo .badge{background:rgba(255,255,255,.2);border-radius:12px;width:38px;height:38px;display:grid;place-items:center;font-size:22px}
  .top-stats{display:flex;gap:14px;margin-left:auto;flex-wrap:wrap}
  .stat{background:rgba(255,255,255,.15);border-radius:12px;padding:6px 14px;font-size:13px;font-weight:600;display:flex;align-items:center;gap:7px;backdrop-filter:blur(4px)}
  .clock{font-variant-numeric:tabular-nums;font-size:14px}
  .icon-btn{background:rgba(255,255,255,.18);border:none;color:#fff;width:38px;height:38px;border-radius:11px;cursor:pointer;font-size:17px;transition:.2s}
  .icon-btn:hover{background:rgba(255,255,255,.32);transform:translateY(-1px)}
  .me-chip{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.15);border-radius:30px;padding:4px 14px 4px 5px;font-size:13px;font-weight:600}
  .me-chip .av{width:30px;height:30px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:17px}

  /* ---------- Layout ---------- */
  .layout{display:grid;grid-template-columns:1fr 340px;gap:20px;padding:20px 22px;max-width:1400px;margin:0 auto}
  @media(max-width:980px){.layout{grid-template-columns:1fr}}

  .card{background:var(--panel);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}
  .card h2{font-size:16px;padding:15px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px}
  .card h2 .hint{margin-left:auto;font-size:12px;font-weight:500;color:var(--muted)}

  /* ---------- Floor ---------- */
  .floor{
    position:relative;display:grid;gap:12px;padding:16px;
    grid-template-columns:1.2fr 1.2fr .9fr;
    grid-template-rows:repeat(4,120px);
    grid-template-areas:
      "reception reception lounge"
      "workspace workspace lounge"
      "workspace workspace meeting"
      "kitchen  kitchen  meeting";
  }
  .room{
    position:relative;border-radius:16px;border:2px dashed var(--room-border);background:var(--room-bg);
    padding:10px 12px;cursor:pointer;overflow:hidden;transition:.25s;display:flex;flex-direction:column;
  }
  .room:hover{border-color:var(--accent1);transform:translateY(-2px);box-shadow:0 8px 22px rgba(79,124,255,.15)}
  .room .rname{font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px;z-index:2}
  .room .rsub{font-size:11px;color:var(--muted);z-index:2}
  .room .furn{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:52px;opacity:.16;pointer-events:none;user-select:none}
  .r-reception{grid-area:reception}.r-workspace{grid-area:workspace}.r-lounge{grid-area:lounge}
  .r-kitchen{grid-area:kitchen}.r-meeting{grid-area:meeting}
  .room .go{position:absolute;right:10px;bottom:8px;font-size:11px;font-weight:700;color:var(--accent1);opacity:0;transition:.2s;z-index:2}
  .room:hover .go{opacity:1}

  /* people */
  .person{
    position:absolute;z-index:3;display:flex;flex-direction:column;align-items:center;width:58px;
    transform:translate(-50%,-50%);cursor:pointer;transition:.2s;
  }
  .person:hover{transform:translate(-50%,-54%) scale(1.08)}
  .person .pav{
    width:44px;height:44px;border-radius:50%;background:var(--panel);border:3px solid var(--ok);
    display:grid;place-items:center;font-size:24px;box-shadow:0 4px 10px rgba(0,0,0,.15);position:relative;
  }
  .person.busy .pav{border-color:var(--busy)}
  .person.offline .pav{border-color:var(--off);filter:grayscale(.8);opacity:.75}
  .person .pav .dot{position:absolute;right:-3px;bottom:-3px;width:13px;height:13px;border-radius:50%;border:2.5px solid var(--panel);background:var(--ok)}
  .person.busy .pav .dot{background:var(--busy)}
  .person.offline .pav .dot{background:var(--off)}
  .person .pname{font-size:10px;font-weight:700;background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:1px 6px;margin-top:3px;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,.08)}
  .person.online .pav{animation:breathe 2.6s ease-in-out infinite}
  @keyframes breathe{0%,100%{box-shadow:0 0 0 0 rgba(34,181,115,.35)}50%{box-shadow:0 0 0 8px rgba(34,181,115,0)}}

  /* ---------- Sidebar tabs ---------- */
  .tabs{display:flex;gap:6px;padding:10px 14px 0}
  .tab{flex:1;padding:8px 4px;text-align:center;font-size:13px;font-weight:700;border-radius:10px;cursor:pointer;color:var(--muted);border:1px solid transparent;transition:.2s}
  .tab.active{background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;border-color:transparent}
  .tab-body{padding:14px 16px 18px;min-height:380px}
  .tabpane{display:none}.tabpane.active{display:block;animation:fade .25s}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

  /* team list */
  .tmember{display:flex;align-items:center;gap:11px;padding:9px 8px;border-radius:12px;cursor:pointer;transition:.2s}
  .tmember:hover{background:var(--panel-2)}
  .tmember .tav{width:38px;height:38px;border-radius:50%;background:var(--panel-2);border:2px solid var(--ok);display:grid;place-items:center;font-size:20px;position:relative;flex-shrink:0}
  .tmember.busy .tav{border-color:var(--busy)}
  .tmember.offline .tav{border-color:var(--off);filter:grayscale(.8);opacity:.7}
  .tmember .tav .dot{position:absolute;right:-2px;bottom:-2px;width:11px;height:11px;border-radius:50%;border:2px solid var(--panel);background:var(--ok)}
  .tmember.busy .tav .dot{background:var(--busy)}.tmember.offline .tav .dot{background:var(--off)}
  .tmember .tn{font-size:13px;font-weight:700;line-height:1.25}
  .tmember .tr{font-size:11px;color:var(--muted)}
  .tmember .tst{margin-left:auto;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(34,181,115,.12);color:var(--ok)}
  .tmember.busy .tst{background:rgba(255,159,67,.15);color:var(--busy)}
  .tmember.offline .tst{background:rgba(154,167,189,.15);color:var(--off)}

  /* tasks */
  .task-progress{height:8px;border-radius:8px;background:var(--panel-2);overflow:hidden;margin:4px 0 14px}
  .task-progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent1),var(--ok));border-radius:8px;transition:width .4s}
  .task-add{display:flex;gap:8px;margin-bottom:12px}
  .task-add input{flex:1;border:1px solid var(--border);background:var(--panel-2);color:var(--text);border-radius:11px;padding:9px 12px;font-size:13px;outline:none}
  .task-add input:focus{border-color:var(--accent1)}
  .task-add button{border:none;background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;border-radius:11px;padding:0 15px;font-size:17px;cursor:pointer;font-weight:800}
  .task{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:12px;background:var(--panel-2);margin-bottom:8px;font-size:13px;animation:fade .25s}
  .task input{width:17px;height:17px;accent-color:var(--accent1);cursor:pointer;flex-shrink:0}
  .task.done span{text-decoration:line-through;color:var(--muted)}
  .task .del{margin-left:auto;background:none;border:none;color:var(--off);cursor:pointer;font-size:15px;padding:2px 6px;border-radius:7px}
  .task .del:hover{color:#ff5d5d;background:rgba(255,93,93,.1)}

  /* schedule */
  .meet{display:flex;gap:12px;padding:11px 10px;border-radius:12px;background:var(--panel-2);margin-bottom:10px;align-items:center}
  .meet .mtime{text-align:center;flex-shrink:0;width:52px}
  .meet .mtime b{display:block;font-size:15px;color:var(--accent1)}
  .meet .mtime small{font-size:10px;color:var(--muted)}
  .meet .mtitle{font-size:13px;font-weight:700;line-height:1.3}
  .meet .mtitle small{display:block;font-weight:500;color:var(--muted);font-size:11px;margin-top:2px}
  .meet button{margin-left:auto;border:none;background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;font-size:12px;font-weight:700;padding:8px 14px;border-radius:10px;cursor:pointer;white-space:nowrap;transition:.2s}
  .meet button:hover{transform:scale(1.05)}
  .meet.done button{background:var(--off);cursor:default}

  /* ---------- Modal ---------- */
  .overlay{position:fixed;inset:0;background:rgba(10,18,38,.55);backdrop-filter:blur(4px);z-index:100;display:none;align-items:center;justify-content:center;padding:20px}
  .overlay.show{display:flex;animation:fade .2s}
  .modal{background:var(--panel);border-radius:20px;max-width:480px;width:100%;box-shadow:0 30px 80px rgba(0,0,0,.35);overflow:hidden;animation:pop .25s}
  @keyframes pop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
  .modal-head{padding:18px 20px;background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;display:flex;align-items:center;gap:12px}
  .modal-head .mav{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,.2);display:grid;place-items:center;font-size:27px}
  .modal-head b{font-size:17px}.modal-head small{display:block;opacity:.85;font-size:12px;margin-top:2px}
  .modal-head .x{margin-left:auto;background:rgba(255,255,255,.2);border:none;color:#fff;width:34px;height:34px;border-radius:10px;cursor:pointer;font-size:16px}
  .modal-body{padding:20px}
  .room-info{font-size:13px;color:var(--muted);line-height:1.6;margin-bottom:16px}
  .room-people{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}
  .rp{display:flex;align-items:center;gap:8px;background:var(--panel-2);border:1px solid var(--border);border-radius:30px;padding:5px 13px 5px 5px;font-size:12px;font-weight:700}
  .rp i{width:30px;height:30px;border-radius:50%;background:var(--panel);display:grid;place-items:center;font-style:normal;font-size:17px}
  .btn-row{display:flex;gap:10px}
  .btn{flex:1;border:none;border-radius:12px;padding:12px;font-size:13px;font-weight:800;cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center;gap:7px}
  .btn:hover{transform:translateY(-2px)}
  .btn.primary{background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff}
  .btn.ghost{background:var(--panel-2);color:var(--text);border:1px solid var(--border)}

  /* ---------- Meeting ---------- */
  .meeting-modal{max-width:720px}
  .video-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:18px}
  .vtile{position:relative;aspect-ratio:4/3;border-radius:14px;background:linear-gradient(145deg,#232f52,#141d38);overflow:hidden;display:grid;place-items:center;border:2px solid transparent;transition:.3s}
  .vtile.speaking{border-color:var(--ok);box-shadow:0 0 0 3px rgba(34,181,115,.25)}
  .vtile .vav{font-size:44px;filter:drop-shadow(0 6px 10px rgba(0,0,0,.4))}
  .vtile .vname{position:absolute;left:8px;bottom:8px;background:rgba(0,0,0,.5);color:#fff;font-size:11px;font-weight:700;padding:3px 9px;border-radius:8px}
  .vtile .vbadge{position:absolute;right:8px;top:8px;font-size:13px}
  .vtile.off{background:linear-gradient(145deg,#2a2f3d,#1a1e28)}
  .vtile.off .vav{filter:grayscale(1) brightness(.7)}
  .meet-controls{display:flex;gap:12px;justify-content:center;padding:0 18px 20px}
  .mctl{width:52px;height:52px;border-radius:50%;border:none;font-size:20px;cursor:pointer;background:var(--panel-2);color:var(--text);border:1px solid var(--border);transition:.2s;position:relative}
  .mctl:hover{transform:scale(1.08)}
  .mctl.off{background:#ff4d5e;color:#fff;border-color:transparent}
  .mctl.leave{background:#ff4d5e;color:#fff}
  .meet-topic{text-align:center;padding:16px 18px 0;font-size:14px;font-weight:800}
  .meet-timer{text-align:center;font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums;margin-top:2px}

  /* ---------- Chat ---------- */
  .chat-fab{
    position:fixed;right:24px;bottom:24px;width:60px;height:60px;border-radius:50%;border:none;cursor:pointer;z-index:60;
    background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;font-size:26px;
    box-shadow:0 12px 30px rgba(79,124,255,.45);transition:.25s;
  }
  .chat-fab:hover{transform:scale(1.08) rotate(-6deg)}
  .chat-fab .badge{position:absolute;top:-4px;right:-4px;background:#ff4d5e;color:#fff;font-size:11px;font-weight:800;min-width:21px;height:21px;border-radius:11px;display:grid;place-items:center;border:2px solid var(--bg)}
  .chat-box{
    position:fixed;right:24px;bottom:96px;width:340px;max-width:calc(100vw - 40px);z-index:70;border-radius:18px;overflow:hidden;
    background:var(--panel);border:1px solid var(--border);box-shadow:0 25px 60px rgba(0,0,0,.28);display:none;flex-direction:column;
  }
  .chat-box.show{display:flex;animation:pop .22s}
  .chat-head{background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;padding:13px 16px;display:flex;align-items:center;gap:10px}
  .chat-head .cav{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.2);display:grid;place-items:center;font-size:19px}
  .chat-head b{font-size:14px}.chat-head small{display:block;font-size:11px;opacity:.85}
  .chat-head .x{margin-left:auto;background:rgba(255,255,255,.2);border:none;color:#fff;width:30px;height:30px;border-radius:9px;cursor:pointer}
  .chat-msgs{height:300px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:9px;background:var(--panel-2)}
  .msg{max-width:78%;padding:9px 13px;border-radius:14px;font-size:13px;line-height:1.45;animation:fade .2s;word-wrap:break-word}
  .msg.them{background:var(--panel);border:1px solid var(--border);border-bottom-left-radius:4px;align-self:flex-start}
  .msg.me{background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;border-bottom-right-radius:4px;align-self:flex-end}
  .msg small{display:block;font-size:10px;opacity:.7;margin-top:3px}
  .chat-input{display:flex;gap:8px;padding:10px;border-top:1px solid var(--border)}
  .chat-input input{flex:1;border:1px solid var(--border);background:var(--panel-2);color:var(--text);border-radius:20px;padding:10px 15px;font-size:13px;outline:none}
  .chat-input button{border:none;background:linear-gradient(120deg,var(--accent1),var(--accent2));color:#fff;border-radius:50%;width:40px;height:40px;cursor:pointer;font-size:16px;flex-shrink:0}

  /* toast */
  .toasts{position:fixed;top:74px;left:50%;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:8px;align-items:center}
  .toast{background:var(--panel);border:1px solid var(--border);box-shadow:var(--shadow);border-radius:12px;padding:10px 18px;font-size:13px;font-weight:700;display:flex;gap:8px;align-items:center;animation:pop .25s}
  .welcome{max-width:1400px;margin:18px auto 0;padding:0 22px}
  .welcome .card{padding:16px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .welcome h1{font-size:18px}.welcome p{font-size:13px;color:var(--muted);margin-top:3px}
  .welcome .wem{font-size:34px}
</style>
</head>
<body>

<header class="topbar">
  <div class="logo"><span class="badge">🏢</span> Virtual Ofis</div>
  <div class="top-stats">
    <div class="stat">🟢 <span id="statOnline">0</span> onlayn</div>
    <div class="stat">✅ <span id="statTasks">0/0</span> vazifa</div>
    <div class="stat">📅 <span id="statMeets">4</span> yig‘ilish</div>
    <div class="stat clock" id="clock">--:--:--</div>
  </div>
  <button class="icon-btn" id="themeBtn" title="Mavzu">🌙</button>
  <div class="me-chip"><span class="av">🧑🏻‍💼</span> Siz (Admin)</div>
</header>

<div class="welcome">
  <div class="card">
    <span class="wem">👋</span>
    <div>
      <h1>Xush kelibsiz! Bugun <span id="todayDate"></span></h1>
      <p>Xonalarga bosing, jamoa a’zolari bilan suhbatlashing, vazifalarni belgilang va majlisni boshlang. Ma’lumotlar brauzeringizda saqlanadi.</p>
    </div>
  </div>
</div>

<div class="layout">
  <!-- FLOOR -->
  <section class="card">
    <h2>🏠 Ofis rejasi <span class="hint">Xona yoki xodimni bosing</span></h2>
    <div class="floor" id="floor"></div>
  </section>

  <!-- SIDEBAR -->
  <aside class="card">
    <div class="tabs">
      <div class="tab active" data-tab="team">👥 Jamoa</div>
      <div class="tab" data-tab="tasks">✅ Vazifalar</div>
      <div class="tab" data-tab="day">📅 Kun</div>
    </div>
    <div class="tab-body">
      <div class="tabpane active" id="pane-team"></div>
      <div class="tabpane" id="pane-tasks">
        <div class="task-progress"><i id="taskBar"></i></div>
        <div class="task-add">
          <input id="taskInput" placeholder="Yangi vazifa qo‘shing..." maxlength="80">
          <button id="taskAdd" title="Qo‘shish">+</button>
        </div>
        <div id="taskList"></div>
      </div>
      <div class="tabpane" id="pane-day"></div>
    </div>
  </aside>
</div>

<!-- Generic modal -->
<div class="overlay" id="overlay">
  <div class="modal" id="modal"></div>
</div>

<!-- Chat -->
<button class="chat-fab" id="chatFab">💬<span class="badge" id="chatBadge" style="display:none">0</span></button>
<div class="chat-box" id="chatBox">
  <div class="chat-head">
    <span class="cav" id="chatAv">👥</span>
    <div><b id="chatName">Umumiy jamoa chati</b><small id="chatStatus">6 ishtirokchi</small></div>
    <button class="x" id="chatClose">✕</button>
  </div>
  <div class="chat-msgs" id="chatMsgs"></div>
  <div class="chat-input">
    <input id="chatInput" placeholder="Xabar yozing..." maxlength="200">
    <button id="chatSend">➤</button>
  </div>
